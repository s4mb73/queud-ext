# SA Rugby account (required for availability + cart)
SARUGBY_EMAIL=you@example.com
SARUGBY_PASSWORD=your-password

# Connection: leave empty to use data/proxies.txt pool; direct = pool (not bare IP); or host:port:user:pass
SPRINGBOKS_PROXY=
# Proxy pool file (one host:port:user:pass per line; # comments OK)
# SPRINGBOKS_PROXY_FILE=data/proxies.txt

# Events: event_id:position (comma-separated for multiple)
SPRINGBOKS_EVENTS=42:7
SPRINGBOKS_TICKETS_REQUIRED=2
SPRINGBOKS_EXACT_PAIRS=0
SPRINGBOKS_INTERVAL_SEC=300

# Auto cart (off by default — enable only when ready to buy)
SPRINGBOKS_AUTO_CART=0
SPRINGBOKS_CART_DELAY_SEC=0
SPRINGBOKS_CART_MAX_ATTEMPTS=2
QUEUD_AIO_CART_LOCK_ATTEMPTS=2

# Cart safety filters (Queud AIO)
QUEUD_AIO_CART_DRY_RUN=0
QUEUD_AIO_CART_MAX_PRICE=
QUEUD_AIO_CART_SECTIONS=

# Session / state paths (optional overrides)
# SPRINGBOKS_COOKIE_FILE=data/http_session.json
# SPRINGBOKS_STATE_FILE=data/monitor_state.json
# SPRINGBOKS_PROFILE_DIR=data/profile

# Discord alerts
DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_FILE=data/discord_webhook

# ntfy (optional)
SPRINGBOKS_NTFY_TOPIC=springboks-stock-CHANGE-ME

# CapSolver (only if TMPT_SOLVER=capsolver)
CAPSOLVER_API_KEY=

# tmpt solver: http | headless | headless-pool | auto | capsolver
#   auto       = HTTP first, headless pool fallback (recommended)
#   headless   = scalable Playwright pool (passes Akamai _abck + tmpt)
TMPT_SOLVER=auto
QUEUD_AIO_TMPT_POOL_WORKERS=3
QUEUD_AIO_TMPT_CACHE_TTL=240
QUEUD_AIO_TMPT_HEADLESS_TIMEOUT=120
QUEUD_AIO_TMPT_AUTO_FALLBACK=1
# Reuse data/profile from bootstrap (more reliable Akamai pass)
QUEUD_AIO_HEADLESS_USE_PROFILE=1

# --- Windows RD (leave running 24/7) ---
# Copy project folder to RD, run scripts\rd_setup.ps1 once, edit .env, then:
#   rd_monitor.bat   OR   dist\QueudAIO\QueudAIO.exe
# Logs: data\monitor.log  |  Auto-start: scripts\rd_autostart.ps1
# Stay logged into RD (disconnect OK, don't Sign out).

# HTTP client — wreq with Chrome TLS/JA3 emulation (no Playwright in monitor/cart path)
SPRINGBOKS_IMPERSONATE=chrome124
# QUEUD_AIO_BROWSER_REQUESTS is deprecated (ignored); monitor/cart use wreq only
QUEUD_AIO_SESSION_MAX_STEPS=12
QUEUD_AIO_QUEUE_WAIT_SEC=5

# CSV profiles (optional — per-row webhook channel)
# QUEUD_AIO_PROFILES_CSV=data/profiles.csv
# QUEUD_AIO_PROFILE_ROW=1
# Columns: URL, Email, Password, Quantity, Webhook [, Site]
# Webhook = Discord URL or path to webhook file; blank = DISCORD_WEBHOOK_URL below

# queud basket API — Carbon-style short Discord links (requires public HTTPS)
# Deploy queud_api/server.py (Railway, VPS, Cloudflare tunnel), then set base URL:
# QUEUD_API_BASE=https://api.yourdomain.com
#   or Railway default: https://your-service.up.railway.app
# QUEUD_API_KEY=optional-secret-for-POST-and-session-endpoints
# QUEUD_BASKET_TTL_MIN=30
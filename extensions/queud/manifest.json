{
  "manifest_version": 3,
  "name": "queud",
  "version": "1.3.3",
  "description": "Inject checkout session cookies and open your basket.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "queud"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.up.railway.app/*",
        "https://*.railway.app/*"
      ],
      "js": ["basket-bridge.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "cookies",
    "tabs",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "https://*.up.railway.app/*",
      "https://*.railway.app/*",
      "https://cdn.discordapp.com/*",
      "https://media.discordapp.net/*",
      "https://0x0.st/*"
    ]
  }
}